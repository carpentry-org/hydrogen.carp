(load "Test.carp")
(load "../hydrogen.carp")

(use Test)

(def CTX (Hydro.context "TestCtx!"))

(defn unwrap-buf [m] (match m (Maybe.Just v) v (Maybe.Nothing) []))

(deftest test
  (assert-equal test
    8
    (Array.length &(Hydro.buf "12345678"))
    "buf creates array of correct length")
  (assert-equal test
    "hello"
    &(Hydro.unbuf &(Hydro.buf "hello"))
    "buf and unbuf round-trip")
  (assert-true test
    (not (Hydro.= &(Hydro.buf "abc") &(Hydro.buf "xyz")))
    "different buffers are not equal")
  (assert-true test
    (Hydro.= &(Hydro.buf "same") &(Hydro.buf "same"))
    "identical buffers are equal")

  (assert-equal test
    "4142"
    &(Hydro.to-hex &(Hydro.buf "AB"))
    "to-hex renders lowercase hex digit pairs")
  (assert-equal test
    64
    (String.length &(Hydro.to-hex &(HydroSecretBox.keygen)))
    "to-hex renders two characters per byte")
  (assert-equal test
    ""
    &(Hydro.to-hex &[])
    "to-hex of an empty array is the empty string")
  (assert-true test
    (let [key (HydroSecretBox.keygen)]
      (Hydro.= &key &(unwrap-buf (Hydro.from-hex &(Hydro.to-hex &key)))))
    "hex round-trips a key")
  (assert-true test
    (let [hash (unwrap-buf
            (HydroHash.gen &(Hydro.buf "test")
                           (Hydro.context "HashCtx!")
                           &(HydroHash.keygen)))]
      (Hydro.= &hash &(unwrap-buf (Hydro.from-hex &(Hydro.to-hex &hash)))))
    "hex round-trips a hash")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          cipher (unwrap-buf
            (HydroSecretBox.encrypt &(Hydro.buf "secret message") 0 CTX &key))]
      (Hydro.= &cipher &(unwrap-buf (Hydro.from-hex &(Hydro.to-hex &cipher)))))
    "hex round-trips a ciphertext")
  (assert-true test
    (Hydro.= &(Hydro.buf "JK") &(unwrap-buf (Hydro.from-hex "4a4B")))
    "from-hex accepts upper- and lowercase digits")
  (assert-true test
    (match (Hydro.from-hex "")
      (Maybe.Just v) (= 0 (Array.length &v))
      (Maybe.Nothing) false)
    "from-hex of the empty string is the empty array")
  (assert-true test
    (Maybe.nothing? &(Hydro.from-hex "abc"))
    "from-hex rejects odd-length input")
  (assert-true test
    (Maybe.nothing? &(Hydro.from-hex "a"))
    "from-hex rejects a lone hex digit")
  (assert-true test
    (Maybe.nothing? &(Hydro.from-hex "zz"))
    "from-hex rejects non-hex characters")
  (assert-true test
    (Maybe.nothing? &(Hydro.from-hex "41zz"))
    "from-hex rejects trailing garbage")
  (assert-true test
    (Maybe.nothing? &(Hydro.from-hex "41 42"))
    "from-hex rejects separators")

  (assert-true test (let [_ (HydroRandom.u32)] true) "u32 does not crash")
  (assert-equal test
    16
    (Array.length &(HydroRandom.buf 16))
    "buf returns array of requested length")
  (assert-equal test
    0
    (Array.length &(HydroRandom.buf 0))
    "buf with 0 returns empty array")
  (assert-true test
    (< (HydroRandom.uniform 10) 10)
    "uniform returns value below upper bound")
  (assert-true test
    (let [seed (Hydro.buf &(String.allocate HydroRandom.seed-bytes \x))
          a (HydroRandom.buf-deterministic 16 &seed)
          b (HydroRandom.buf-deterministic 16 &seed)]
      (Hydro.= &a &b))
    "buf-deterministic is deterministic")

  (assert-true test
    (Maybe.just?
      &(HydroHash.gen &(Hydro.buf "test")
                      (Hydro.context "HashCtx!")
                      &(HydroHash.keygen)))
    "gen succeeds with valid inputs")
  (assert-true test
    (let [key (HydroHash.keygen)
          ctx (Hydro.context "HashCtx!")
          h1 (unwrap-buf (HydroHash.gen &(Hydro.buf "test") ctx &key))
          h2 (unwrap-buf (HydroHash.gen &(Hydro.buf "test") ctx &key))]
      (Hydro.= &h1 &h2))
    "gen is deterministic for same inputs")
  (assert-true test
    (let [key (HydroHash.keygen)
          ctx (Hydro.context "HashCtx!")
          h1 (unwrap-buf (HydroHash.gen &(Hydro.buf "test") ctx &key))
          h2 (unwrap-buf (HydroHash.gen &(Hydro.buf "other") ctx &key))]
      (not (Hydro.= &h1 &h2)))
    "gen produces different hashes for different inputs")

  (assert-true test
    (let [key (HydroSecretBox.keygen)
          msg (Hydro.buf "secret message")]
      (Maybe.just? &(HydroSecretBox.encrypt &msg 0 CTX &key)))
    "encrypt succeeds")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          msg (Hydro.buf "secret message")
          cipher (unwrap-buf (HydroSecretBox.encrypt &msg 0 CTX &key))
          plain (unwrap-buf (HydroSecretBox.decrypt &cipher 0 CTX &key))]
      (Hydro.= &msg &plain))
    "encrypt/decrypt round-trip")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          msg (Hydro.buf "secret message")
          cipher (unwrap-buf (HydroSecretBox.encrypt &msg 0 CTX &key))
          wrong-key (HydroSecretBox.keygen)]
      (Maybe.nothing? &(HydroSecretBox.decrypt &cipher 0 CTX &wrong-key)))
    "decrypt with wrong key fails")

  (assert-equal test
    16
    (let [key (HydroSecretBox.keygen)
          cipher (unwrap-buf
            (HydroSecretBox.encrypt &(Hydro.buf "m") 0 CTX &key))]
      (Array.length &(HydroSecretBox.probe &cipher CTX &key)))
    "probe has the length of a hydrogen probe")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          msg (Hydro.buf "secret message")
          cipher (unwrap-buf (HydroSecretBox.encrypt &msg 0 CTX &key))
          p (HydroSecretBox.probe &cipher CTX &key)]
      (HydroSecretBox.probe-verify &p &cipher CTX &key))
    "probe-verify succeeds for the cipher the probe was made for")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          msg (Hydro.buf "secret message")
          cipher (unwrap-buf (HydroSecretBox.encrypt &msg 0 CTX &key))
          p (HydroSecretBox.probe &cipher CTX &key)
          tag-end (dec (- (Array.length &cipher) (Array.length &msg)))
          tampered (Array.aset @&cipher
                               tag-end
                               (Byte.bit-xor @(Array.unsafe-nth &cipher tag-end)
                                             (Byte.from-int 1)))]
      (not (HydroSecretBox.probe-verify &p &tampered CTX &key)))
    "probe-verify fails for a cipher whose tag was tampered with")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          cipher (unwrap-buf
            (HydroSecretBox.encrypt &(Hydro.buf "secret message") 0 CTX &key))
          other (unwrap-buf
            (HydroSecretBox.encrypt &(Hydro.buf "other message") 0 CTX &key))
          p (HydroSecretBox.probe &cipher CTX &key)]
      (not (HydroSecretBox.probe-verify &p &other CTX &key)))
    "probe-verify fails for a different cipher")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          cipher (unwrap-buf
            (HydroSecretBox.encrypt &(Hydro.buf "secret message") 0 CTX &key))
          p (HydroSecretBox.probe &cipher CTX &key)]
      (not (HydroSecretBox.probe-verify &p &cipher CTX &(HydroSecretBox.keygen))))
    "probe-verify fails with a different key")
  (assert-true test
    (let [key (HydroSecretBox.keygen)
          cipher (unwrap-buf
            (HydroSecretBox.encrypt &(Hydro.buf "secret message") 0 CTX &key))
          p (HydroSecretBox.probe &cipher CTX &key)]
      (not
        (HydroSecretBox.probe-verify &p &cipher (Hydro.context "OtherCt!") &key)))
    "probe-verify fails with a different context")

  (assert-true test
    (Maybe.just? &(HydroKDF.derive-from-key 32 1 CTX &(HydroKDF.keygen)))
    "derive-from-key succeeds with valid inputs")
  (assert-true test
    (let [key (HydroKDF.keygen)
          s1 (unwrap-buf (HydroKDF.derive-from-key 32 1 CTX &key))
          s2 (unwrap-buf (HydroKDF.derive-from-key 32 1 CTX &key))]
      (Hydro.= &s1 &s2))
    "derive-from-key is deterministic for same inputs")
  (assert-true test
    (let [key (HydroKDF.keygen)
          s1 (unwrap-buf (HydroKDF.derive-from-key 32 1 CTX &key))
          s2 (unwrap-buf (HydroKDF.derive-from-key 32 2 CTX &key))]
      (not (Hydro.= &s1 &s2)))
    "derive-from-key with different IDs produces different subkeys")
  (assert-true test
    (let [k1 (HydroKDF.keygen)
          k2 (HydroKDF.keygen)
          s1 (unwrap-buf (HydroKDF.derive-from-key 32 1 CTX &k1))
          s2 (unwrap-buf (HydroKDF.derive-from-key 32 1 CTX &k2))]
      (not (Hydro.= &s1 &s2)))
    "derive-from-key with different keys produces different subkeys")

  (assert-true test
    (let [kp (HydroSign.keygen)]
      (Maybe.just? &(HydroSign.create &(Hydro.buf "test") CTX &kp)))
    "sign create succeeds")
  (assert-true test
    (let [kp (HydroSign.keygen)
          msg (Hydro.buf "test")
          sig (unwrap-buf (HydroSign.create &msg CTX &kp))]
      (HydroSign.verify &sig &msg CTX &kp))
    "sign verify succeeds with correct signature")
  (assert-true test
    (let [kp (HydroSign.keygen)
          msg (Hydro.buf "test")
          sig (unwrap-buf (HydroSign.create &msg CTX &kp))]
      (not (HydroSign.verify &sig &(Hydro.buf "wrong") CTX &kp)))
    "sign verify fails with wrong message")
  (assert-true test
    (let-do [kp (HydroSign.keygen)
             s (HydroSign.state)]
      (ignore (HydroSign.init &s CTX))
      (ignore (HydroSign.update &s &(Hydro.buf "part1")))
      (ignore (HydroSign.update &s &(Hydro.buf "part2")))
      (Maybe.just? &(HydroSign.final-create &s &kp)))
    "multi-part sign create succeeds")
  (assert-true test
    (let-do [kp (HydroSign.keygen)
             s (HydroSign.state)]
      (ignore (HydroSign.init &s CTX))
      (ignore (HydroSign.update &s &(Hydro.buf "part1")))
      (ignore (HydroSign.update &s &(Hydro.buf "part2")))
      (let-do [sig (unwrap-buf (HydroSign.final-create &s &kp))]
        (ignore (HydroSign.init &s CTX))
        (ignore (HydroSign.update &s &(Hydro.buf "part1")))
        (ignore (HydroSign.update &s &(Hydro.buf "part2")))
        (HydroSign.final-verify &s sig &kp)))
    "multi-part sign verify round-trip")
  (assert-true test
    (let-do [kp (HydroSign.keygen)
             s (HydroSign.state)]
      (ignore (HydroSign.init &s CTX))
      (ignore (HydroSign.update &s &(Hydro.buf "part1")))
      (ignore (HydroSign.update &s &(Hydro.buf "part2")))
      (let-do [sig (unwrap-buf (HydroSign.final-create &s &kp))]
        (ignore (HydroSign.init &s CTX))
        (ignore (HydroSign.update &s &(Hydro.buf "different")))
        (not (HydroSign.final-verify &s sig &kp))))
    "multi-part sign verify fails with different message")

  (assert-true test
    (let [master-key (HydroPWHash.keygen)]
      (Maybe.just? &(HydroPWHash.create "password" &master-key)))
    "create succeeds")
  (assert-true test
    (let [master-key (HydroPWHash.keygen)
          hash (unwrap-buf (HydroPWHash.create "password" &master-key))]
      (HydroPWHash.verify hash "password" &master-key))
    "verify succeeds with correct password")
  (assert-true test
    (let [master-key (HydroPWHash.keygen)
          hash (unwrap-buf (HydroPWHash.create "password" &master-key))]
      (not (HydroPWHash.verify hash "wrong" &master-key)))
    "verify fails with wrong password")
  (assert-true test
    (let [master-key (HydroPWHash.keygen)]
      (Maybe.just?
        &(HydroPWHash.hash-deterministic 32 "password" CTX &master-key 100)))
    "hash-deterministic succeeds (no infinite recursion)")
  (assert-true test
    (let [master-key (HydroPWHash.keygen)
          h1 (unwrap-buf
            (HydroPWHash.hash-deterministic 32 "password" CTX &master-key 100))
          h2 (unwrap-buf
            (HydroPWHash.hash-deterministic 32 "password" CTX &master-key 100))]
      (Hydro.= &h1 &h2))
    "hash-deterministic is deterministic"))
